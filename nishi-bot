        return

    try:
        replied_msg = await bot.get_message(chat_id, reply_id)

        if not replied_msg:
            await message.reply("❌ پیام پیدا نشد.")
            return

        if isinstance(replied_msg, dict):
            target_id = (
                replied_msg.get("sender_id")
                or replied_msg.get("from_id")
                or replied_msg.get("author_id")
            )
        else:
            target_id = (
                getattr(replied_msg, "sender_id", None)
                or getattr(replied_msg, "from_id", None)
                or getattr(replied_msg, "author_id", None)
            )

        if not target_id:
            await message.reply("❌ شناسه کاربر پیدا نشد.")
            return

        target_id = str(target_id)

        if target_id == sender_id:
            await message.reply("❌ نمی‌توانی خودت را بن کنی!")
            return

        if target_id == get_group_owner(chat_id):
            await message.reply("❌ نمی‌توانی مالک ربات را بن کنی!")
            return

        if text == "بن":
            await bot.ban_member_chat(chat_id, target_id)

            await message.reply(
                "🚫 کاربر با موفقیت بن شد!\n"
                "━━━━━━━━━━━━━━━\n"
                f"👤 شناسه: {target_id}\n"
                f"🔗 [مشاهده پروفایل]({target_id})"
