        session.pop("game", None)
        session.pop("emoji_answer", None)
        save_db(db)
        await message.reply("🎉 درست گفتی!" if normalize_text(text) == normalize_text(answer)
                            else f"💡 جواب: {answer}")
        return

    if text in ("شمارش کلمات", "بازی کلمات"):
        session["game"] = "wordcount"
        save_db(db)
        await message.reply("✍️ یک جمله بفرست تا تعداد کلماتش رو بشمارم!")
        return

    if session.get("game") == "wordcount":
        count = len(text.split())
        session.pop("game", None)
        save_db(db)
        await message.reply(f"🔠 این جمله {count} کلمه داشت!")
        return

    if text in ("بازی سرعت", "سرعت عمل"):
        target = random.choice(["الان", "نیشی", "روبیکا", "آفرین", "💥"])
