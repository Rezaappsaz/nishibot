    if session.get("game") == "memory":
        answer = session.get("memory_answer", "")
        session.pop("game", None)
        session.pop("memory_answer", None)
        save_db(db)
        cleaned = text.replace(" ", "")
        await message.reply("🏆 حافظه‌ات عالیه!" if cleaned == answer
