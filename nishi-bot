    sender_id = str(message.sender_id)
    chat_id = str(message.chat_id)

    # فقط مالک و مدیر ویژه
    special_admins = db.get("special_admins", {}).get(chat_id, [])

    if sender_id != get_group_owner(chat_id) and sender_id not in special_admins:
        return

    if text not in ["کیل", "رفع کیل"]:
        return

    reply_id = getattr(message, "reply_to_message_id", None)

    if not reply_id:
        await message.reply("❌ روی پیام کاربر ریپلای کن.")
