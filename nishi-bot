@bot.on_message()
async def special_admin_manager(bot: Robot, message: Message):

    text = message.text.strip() if message.text else ""

    sender_id = str(message.sender_id)
    chat_id = str(message.chat_id)

    # فقط مالک اجازه مدیریت مدیرهای ویژه دارد
    if sender_id != get_group_owner(chat_id):
        return

    if text == "لیست ویژه":

        admins = db.get("special_admins", {}).get(chat_id, [])

        if not admins:
            await message.reply("❌ هیچ مدیر ویژه‌ای ثبت نشده.")
            return

        result = "👑 لیست مدیرهای ویژه:\n\n"

        for i, uid in enumerate(admins, 1):
            result += f"{i}. [{uid}]({uid})\n"

        await message.reply(result)
        return

    if text not in ["ویژه", "حذف ویژه"]:
        return

    reply_id = getattr(message, "reply_to_message_id", None)

    if not reply_id:
        await message.reply("❌ روی پیام شخص موردنظر ریپلای کن.")
        return


    try:
        replied_msg = await bot.get_message(chat_id, reply_id)

        if isinstance(replied_msg, dict):
            target_id = (
                replied_msg.get("sender_id")
                or replied_msg.get("from_id")
                or replied_msg.get("author_id")
            )
        else:
            target_id = (
                getattr(replied_msg, "sender_id", None)
                or getattr(replied_msg, "from_id", None)
                or getattr(replied_msg, "author_id", None)
            )

        if not target_id:
            await message.reply("❌ شناسه کاربر پیدا نشد.")
            return

        target_id = str(target_id)

        if target_id == get_group_owner(chat_id):
            await message.reply("❌ مالک نیازی به مدیر ویژه شدن ندارد.")
            return

        if chat_id not in db["special_admins"]:
            db["special_admins"][chat_id] = []

        admins = db["special_admins"][chat_id]

        if text == "ویژه":

            if target_id in admins:
                await message.reply("⚠️ این کاربر از قبل مدیر ویژه است.")
                return

            admins.append(target_id)
            save_db(db)

            await message.reply("✅ کاربر با موفقیت مدیر ویژه شد!")

        else:

            if target_id not in admins:
                await message.reply("❌ این کاربر مدیر ویژه نیست.")
                return

            admins.remove(target_id)
            save_db(db)

            await message.reply("✅ مدیریت ویژه از کاربر گرفته شد!")

    except Exception as e:
        print("Special admin error:", repr(e))
        await message.reply(f"❌ خطا:\n{e}")




