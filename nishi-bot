                return

            kill_users.append(target_id)
            save_db(db)

            await message.reply(
                "💀 حالت کیل فعال شد!\n"
                "━━━━━━━━━━━━━━━\n"
                f"👤 شناسه: {target_id}\n"
                "🚫 اولین تخلف امنیتی باعث بن فوری می‌شود."
