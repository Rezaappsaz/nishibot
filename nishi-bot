_FONT_MAPS = _build_font_styles()


def make_50_fonts(value):
    # ۵۰ قاب متنی متفاوت؛ برای متن فارسی نیز ۵۰ خروجی مجزا ساخته می‌شود.
    frames = [
        ('', ''), ('「', '」'), ('『', '』'), ('〔', '〕'), ('《', '》'),
        ('【', '】'), ('〖', '〗'), ('〘', '〙'), ('〚', '〛'), ('〈', '〉'),
        ('«', '»'), ('‹', '›'), ('﹝', '﹞'), ('﹙', '﹚'), ('﹛', '﹜'),
        ('⟦', '⟧'), ('⟨', '⟩'), ('⟪', '⟫'), ('⟬', '⟭'), ('⦃', '⦄'),
        ('⌜', '⌟'), ('⌞', '⌝'), ('⦅', '⦆'), ('⦗', '⦘'), ('⧼', '⧽'),
        ('— ', ' —'), ('- ', ' -'), ('= ', ' ='), ('~ ', ' ~'), ('_ ', ' _'),
        ('· ', ' ·'), ('• ', ' •'), ('∙ ', ' ∙'), ('⋆ ', ' ⋆'), ('⁕ ', ' ⁕'),
        ('╭ ', ' ╮'), ('╰ ', ' ╯'), ('┌ ', ' ┐'), ('└ ', ' ┘'), ('╔ ', ' ╗'),
        ('╚ ', ' ╝'), ('┏ ', ' ┓'), ('┗ ', ' ┛'), ('╓ ', ' ╖'), ('╙ ', ' ╜'),
        ('〔 ', ' 〕'), ('〖 ', ' 〗'), ('⟪ ', ' ⟫'), ('《 ', ' 》'), ('「 ', ' 」'),
    ]
    results = []
    for style_index, style_map in enumerate(_FONT_MAPS):
        converted = ''.join(style_map.get(ch, ch) for ch in value)
        for left, right in frames[style_index * 5:(style_index + 1) * 5]:
            candidate = f"{left}{converted}{right}"
            if candidate not in results:
                results.append(candidate)
    return results[:50]


def build_copy_fonts_keypad(fonts):
    # دکمهٔ CopyText به‌صورت دادهٔ خام برای API روبیکا فرستاده می‌شود.
    rows = []
    for i in range(0, len(fonts), 2):
        buttons = []
        for j in range(i, min(i + 2, len(fonts))):
            value = fonts[j]
            buttons.append({
                'id': f'font_copy_{j + 1}',
                'type': 'CopyText',
                'button_text': value,
                'button_copy_text': {'text': value},
            })
        rows.append({'buttons': buttons})
    return {'rows': rows}


