                await message.reply("❌ این کاربر کیل نیست.")
                return

            kill_users.remove(target_id)
            save_db(db)

            await message.reply(
                "✅ حالت کیل غیرفعال شد!\n"
                "━━━━━━━━━━━━━━━\n"
                f"👤 شناسه: {target_id}"
