                f"👤 شناسه: {target_id}\n"
                f"🔗 [مشاهده پروفایل]({target_id})"
            )

        else:

            muted_users[chat_id].discard(target_id)
            db.setdefault("muted_users", {})[chat_id] = sorted(muted_users[chat_id])
            save_db(db)

            await message.reply(
                "🔊 سکوت کاربر برداشته شد!\n"
                "━━━━━━━━━━━━━━━\n"
                f"👤 شناسه: {target_id}\n"
                f"🔗 [مشاهده پروفایل]({target_id})"
            )

    except Exception as e:
        print("Mute error:", repr(e))
        await message.reply(f"❌ عملیات انجام نشد!\n{e}")



