async def ban_if_kill_user(bot: Robot, message: Message, chat_id: str, sender_id: str) -> bool:
    """
    اگر کاربر در لیست کیل این گروه باشد، با اولین تخلف امنیتی بن می‌شود.
    True یعنی کاربر کیل بوده و مسیر رسیدگی به تخلف انجام شده است.
    """
    kill_users = db.get("kill_users", {}).get(str(chat_id), [])
    kill_ids = {str(uid) for uid in kill_users}

    if str(sender_id) not in kill_ids:
        return False

    try:
        await bot.ban_member_chat(str(chat_id), str(sender_id))

        # پس از بن موفق، کاربر از لیست کیل خارج می‌شود.
        db["kill_users"][str(chat_id)] = [
            uid for uid in kill_users if str(uid) != str(sender_id)
        ]
        save_db(db)

        await message.reply(
            "💀 کاربرِ دارای حالت کیل، با اولین تخلف امنیتی بدون نیاز به اخطار بن شد!"
        )
    except Exception as e:
        print("Kill auto-ban error:", repr(e))
        await message.reply(
            "❌ کاربر در حالت کیل بود، اما بن کردن او ناموفق شد. "
            "لطفاً دسترسی ربات و شناسه کاربر را بررسی کن."
        )

    return True


@bot.on_message()
async def monitor_messages(bot: Robot, message: Message):

    global is_bot_active, active_owner_id, db, muted_users

    text = message.text.strip() if message.text else ""

    sender_id = str(message.sender_id)
    chat_id = str(message.chat_id)

    # ==================================
    # عضویت اجباری نمایشی (بدون بررسی واقعی عضویت)
    # تعداد پیام‌ها برای هر کاربر در هر گروه جداگانه است.
    # ==================================
    owners_map = db.get("bot_status", {}).get("group_owners", {})
    owner_for_chat = str(owners_map.get(chat_id) or "")
    special_for_chat = [str(x) for x in db.get("special_admins", {}).get(chat_id, [])]
    is_gate_admin = (sender_id == owner_for_chat and bool(owner_for_chat)) or sender_id in special_for_chat

    is_membership_activate = text == "عضویت اجباری فعال" or text.startswith("عضویت اجباری فعال ")
    if is_membership_activate or text in ("عضویت اجباری غیرفعال", "ریست عضویت اجباری"):
        if not is_gate_admin:
            await message.reply("⛔ این دستور فقط برای مالک یا مدیر ویژه است. 👮")
            return

        if is_membership_activate:
            parts = text.split()
            limit = 3
            if len(parts) > 3:
                await message.reply("❌ دستور نامعتبر است. نمونه: عضویت اجباری فعال 2")
                return
            if len(parts) == 3:
                try:
                    limit = int(parts[2])
                    if not 1 <= limit <= 100:
                        raise ValueError
                except ValueError:
                    await message.reply("❌ تعداد باید عددی بین 1 تا 100 باشد.\nنمونه: عضویت اجباری فعال 2")
                    return
            db.setdefault("mandatory_membership", {})[chat_id] = True
            db.setdefault("mandatory_membership_limit", {})[chat_id] = limit
            save_db(db)
            await message.reply(
                "🔒 عضویت اجباری فعال شد!\n"
                "━━━━━━━━━━━━━━\n"
                f"👥 محدودیت پیام کاربران تنظیم شد.\n"
                "📢 کانال: @rabatsazm"
            )
            return

        if text == "عضویت اجباری غیرفعال":
            db.setdefault("mandatory_membership", {})[chat_id] = False
            save_db(db)
            await message.reply("🔓 عضویت اجباری غیرفعال شد؛ پیام‌های اعضا عادی ارسال می‌شود.")
            return

        # ریست شمارنده‌های همه کاربران در همین گروه
        counts = db.setdefault("mandatory_membership_counts", {})
        old_count = len(counts.get(chat_id, {}))
        counts[chat_id] = {}
        save_db(db)
        await message.reply(
            "♻️ شمارنده عضویت اجباری ریست شد!\n"
            f"👥 تعداد کاربران ریست‌شده: {old_count}\n"
            "محدودیت برای کاربران از ابتدا اعمال می‌شود."
        )
        return

    # مالک و مدیر ویژه از محدودیت عضویت اجباری مستثنا هستند.
    if db.setdefault("mandatory_membership", {}).get(chat_id, False) and not is_gate_admin:
        user_counts = db.setdefault("mandatory_membership_counts", {}).setdefault(chat_id, {})
        already_seen = int(user_counts.get(sender_id, 0))
        limit = int(db.setdefault("mandatory_membership_limit", {}).get(chat_id, 3) or 3)
        if already_seen < limit:
            user_counts[sender_id] = already_seen + 1
            save_db(db)
            try:
                await message.delete()
            except Exception as delete_error:
                print("Mandatory membership delete error:", repr(delete_error))
            try:
                await bot.send_message(
                    chat_id,
                    "⛔ شما در کانال @rabatsazm عضو نیستید!\n"
                    "📢 ابتدا عضو کانال شوید و دوباره شروع به ارسال پیام کنید."
                )
            except Exception as send_error:
                print("Mandatory membership notice error:", repr(send_error))
            return

    if not text:
        # پیام‌های رسانه‌ای هم در شمارش پیام‌ها حساب می‌شوند.
        if is_bot_active:
            record_chat_message(chat_id, sender_id)
        return

    # ==================================
    # تشخیص مالک و مدیر ویژه
    # ==================================

    is_owner = sender_id == get_group_owner(chat_id) and bool(get_group_owner(chat_id))

    special_admins = db.get("special_admins", {}).get(chat_id, [])
    is_special = sender_id in special_admins

    # ==================================
    # بررسی سکوت کاربران
    # ==================================

    if sender_id in muted_users.get(chat_id, set()) and not is_owner and not is_special:

        try:
            await message.delete()
        except Exception:
            pass

        await message.reply(
            "🔇 شما در حالت سکوت قرار دارید!\n"
            "━━━━━━━━━━━━━━━\n"
            "❌ اجازه ارسال پیام ندارید."
        )
        return

    # ==================================
    # فعال سازی ربات
    # ==================================

    if text == "فعال":
        owners = db.setdefault("bot_status", {}).setdefault("group_owners", {})
        if not owners.get(chat_id):
            owners[chat_id] = sender_id
            is_bot_active = True
            db["bot_status"]["is_active"] = True
            # مقدار قدیمی فقط برای سازگاری نگه داشته می‌شود؛ مالک واقعی هر گروه جداست.
            db["bot_status"].setdefault("active_owner_id", sender_id)
            save_db(db)
            await message.reply("✅ ربات در این گروه فعال شد!\n👑 مالک گروه ثبت شد.")
        else:
            await message.reply("⚠️ ربات از قبل در این گروه فعال بوده است.")
        return

    # ==================================
    # فونت: «فونت reza»
    # ==================================
    if text.startswith("فونت "):
        original = text[5:].strip()
        if not original:
            await message.reply("❌ بعد از دستور فونت، متن را بنویس.\nنمونه: فونت reza")
            return
        if len(original) > 24:
            await message.reply("❌ متن حداکثر باید ۲۴ کاراکتر باشد.")
            return

        fonts = make_50_fonts(original)
        # ارسال خام از API؛ بدون Markdown parser تا offsetهای متادیتا خراب نشوند.
        # تمام ۵۰ مدل در یک پیام متنی واحد قرار می‌گیرند.
        code_lines = [f"{i}. {font}" for i, font in enumerate(fonts, 1)]
        output_text = (
            f"۵۰ مدل فونت برای: {original}\n"
            "برای کپی، روی متن نگه‌دار و گزینه کپی را بزن.\n\n"
            + "\n".join(code_lines)
        )
        try:
            await bot._post("sendMessage", {
                "chat_id": str(message.chat_id),
                "text": output_text,
                "disable_notification": False
            })
        except Exception as send_error:
            print(f"Font raw send error: {send_error}")
        return


    if not is_bot_active:
        return

    # ==================================
    # مدیریت قفل کلی گروه و فیلتر کلمات
    # ==================================
    if text in ("قفل گروه", "باز گروه"):
        if not (is_owner or is_special):
            await message.reply("⛔ این دستور فقط برای مدیر است. 👮")
            return
        locked = (text == "قفل گروه")
        db.setdefault("group_locked", {})[chat_id] = locked
        save_db(db)
        await message.reply(
            "🔒 گروه قفل شد!\n━━━━━━━━━━━━━━\n🚫 پیام کاربران عادی حذف و برایشان اخطار ثبت می‌شود."
            if locked else
            "🔓 گروه باز شد!\n━━━━━━━━━━━━━━\n💚 ارسال پیام برای اعضا آزاد است."
        )
        return

    if text.startswith("فیلتر کلمه "):
        if not (is_owner or is_special):
            await message.reply("⛔ این دستور فقط برای مدیر است. 👮")
            return
        word = text[len("فیلتر کلمه "):].strip()
        if not word or len(word) > 60:
            await message.reply("⚠️ روش درست: فیلتر کلمه بیوچک")
            return
        words = db.setdefault("word_filters", {}).setdefault(chat_id, [])
        normalized_word = normalize_text(word)
        if any(normalize_text(item) == normalized_word for item in words):
            await message.reply(f"⚠️ کلمه «{word}» از قبل فیلتر شده است.")
        else:
            words.append(word)
            save_db(db)
            await message.reply(f"🚫 کلمه «{word}» به فیلتر گروه اضافه شد.\n⚠️ ارسال آن باعث حذف پیام و ثبت اخطار می‌شود.")
        return

    if text.startswith("حذف فیلتر کلمه "):
        if not (is_owner or is_special):
            await message.reply("⛔ این دستور فقط برای مدیر است. 👮")
            return
        word = text[len("حذف فیلتر کلمه "):].strip()
        words = db.setdefault("word_filters", {}).setdefault(chat_id, [])
        before = len(words)
        words[:] = [item for item in words if normalize_text(item) != normalize_text(word)]
        save_db(db)
        await message.reply("✅ کلمه از فیلتر حذف شد." if len(words) < before else "🔎 این کلمه در فیلتر نبود.")
        return

    if text == "لیست فیلتر کلمه":
        if not (is_owner or is_special):
            await message.reply("⛔ این دستور فقط برای مدیر است. 👮")
            return
        words = db.setdefault("word_filters", {}).get(chat_id, [])
        await message.reply("🧹 کلمات فیلترشده:\n" + ("\n".join(f"• {w}" for w in words) if words else "هنوز کلمه‌ای ثبت نشده است."))
        return

    # فرمان‌های مدیریتی دیگر هم برای افراد عادی پیام دسترسی بدهند.
    if is_group_admin_command(text) and not (is_owner or is_special):
        await message.reply("⛔ این دستور فقط برای مدیر است. 👮")
        return

    if not (is_owner or is_special):
        # قفل کلی گروه: همه پیام‌های اعضای عادی حذف و اخطار می‌شوند.
        if db.setdefault("group_locked", {}).get(chat_id, False):
            try:
                await message.delete()
            except Exception:
                pass
            await give_warning(bot, message, sender_id, "ارسال پیام هنگام قفل بودن گروه")
            return

        # فیلتر کلمات؛ تطبیق بدون حساسیت به ي/ی و ك/ک و نیم‌فاصله.
        normalized_message = normalize_text(text)
        for filtered_word in db.setdefault("word_filters", {}).get(chat_id, []):
            if normalize_text(filtered_word) and normalize_text(filtered_word) in normalized_message:
                try:
                    await message.delete()
                except Exception:
                    pass
                await give_warning(bot, message, sender_id, f"استفاده از کلمه فیلترشده: {filtered_word}")
                return

    # ==================================
    # ==================================
    # بررسی قفل‌های متنی گروه
    # ==================================
    if not is_owner and not is_special:
        locks = db.setdefault("chat_locks", {}).get(chat_id, {})
        lock_reason = None
        normalized = normalize_text(text)
        if locks.get("متن"):
            lock_reason = "متن"
        elif locks.get("لینک") and re.search(r"(https?://|www\.|t\.me/)", text, re.I):
            lock_reason = "لینک"
        elif locks.get("هایپرلینک") and re.search(r"\[[^]]+\]\([^)]+\)", text):
            lock_reason = "هایپرلینک"
        elif locks.get("آیدی") and re.search(r"@\w+", text):
            lock_reason = "آیدی"
        elif locks.get("منشن") and re.search(r"@\w+", text):
            lock_reason = "منشن"
        elif locks.get("فحش") and contains_bad_word(text):
            lock_reason = "فحش"
        elif locks.get("هشتگ") and "#" in text:
            lock_reason = "هشتگ"
        elif locks.get("متن انگلیسی") and re.search(r"[a-zA-Z]{3,}", text):
            lock_reason = "متن انگلیسی"
        elif locks.get("شماره تلفن") and re.search(r"(?<!\w)(?:\+?\d[\d\s\-()]{7,}\d)(?!\w)", text):
            lock_reason = "شماره تلفن"
        elif locks.get("عدد") and re.search(r"\d", text):
            lock_reason = "عدد"
        elif locks.get("ایموجی") and re.search(r"[\U0001F300-\U0001FAFF]", text):
            lock_reason = "ایموجی"
        elif locks.get("تبلیغ") and re.search(r"(عضو شو|تبلیغ|فروش ویژه|خرید از)", normalized):
            lock_reason = "تبلیغ"
        elif locks.get("اسپم") and len(text) > 700:
            lock_reason = "اسپم"
        elif locks.get("کد هنگی") and re.search(r"(.)\1{12,}", text):
            lock_reason = "کد هنگی"
        elif locks.get("جوک") and text == "جوک":
            lock_reason = "جوک"
        elif locks.get("تاس") and text == "تاس":
            lock_reason = "تاس"
        elif locks.get("چالش") and text.startswith("چالش"):
            lock_reason = "چالش"
        elif locks.get("سرگرمی") and text in ("پنالتی", "چیستان", "سنگ کاغذ قیچی", "حدس عدد", "شیر یا خط", "فال", "فال حافظ", "بازی‌ها", "لیست بازی", "بازی ریاضی", "کلمه قاطی", "اسم‌فامیل", "حدس شخصیت", "حقیقت یا جرئت", "حافظه", "بالاتر یا پایین‌تر", "معمای ایموجی", "شمارش کلمات", "بازی سرعت"):
            lock_reason = "سرگرمی"

        if lock_reason:
            try:
                await message.delete()
            except Exception:
                pass
            if await ban_if_kill_user(bot, message, chat_id, sender_id):
                return
            await give_warning(bot, message, sender_id, f"ارسال محتوای قفل‌شده ({lock_reason})")
            return

    # آمار پیام ها
    # ==================================

    record_chat_message(chat_id, sender_id)

    # لقب کمدی تصادفی برای هر کاربر؛ لقب دستی خودش همیشه اولویت دارد.
    random_nicks = db.setdefault("random_nicknames", {})
    if sender_id not in random_nicks:
        random_nicks[sender_id] = random.choice([
