def load_db():

    default = {
        "user_real_names": {},
        "special_admins": {},
        "kill_users": {},
        "user_names": {},
        "user_nicknames": {},
        "random_nicknames": {},
        "user_warnings": {},
        "muted_users": {},
        "chat_locks": {},
        "group_locked": {},
        "word_filters": {},
        "mandatory_membership": {},
        "mandatory_membership_counts": {},
        "mandatory_membership_limit": {},
        "warning_limits": {},
        "game_sessions": {},
        "chat_stats": {},
        "bot_status": {
            "is_active": False,
            "active_owner_id": None,
            "group_owners": {}
        }
    }

    if not os.path.exists(DB_FILE):
        return default

    try:
        with open(DB_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)

        for key, value in default.items():
            if key not in data:
                data[key] = value
        for key in ("chat_locks", "group_locked", "word_filters", "mandatory_membership", "mandatory_membership_counts", "mandatory_membership_limit", "warning_limits", "game_sessions", "muted_users", "user_warnings"):
            if not isinstance(data.get(key), dict):
                data[key] = {}
        if not isinstance(data.get("bot_status"), dict):
            data["bot_status"] = default["bot_status"].copy()
        data["bot_status"].setdefault("group_owners", {})

        return data

    except Exception as e:
        print("Database error:", e)
        return default


def save_db(data):
    try:
        with open(DB_FILE + ".tmp", "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=4)

        os.replace(DB_FILE + ".tmp", DB_FILE)

    except Exception as e:
        print("Save error:", e)


