captcha_codes = {}

def create_captcha(user_id):

    # ساخت کد تصادفی ۶ کاراکتری
    characters = string.ascii_letters + string.digits
    code = "".join(random.choices(characters, k=6))

    width = 280
    height = 105

    # پس‌زمینه تصادفی
    bg = (
        random.randint(10, 45),
        random.randint(10, 45),
        random.randint(20, 55)
    )

    image = Image.new("RGB", (width, height), bg)
    draw = ImageDraw.Draw(image)

    # خطوط رنگی مزاحم
    for _ in range(18):
        x1 = random.randint(0, width)
        y1 = random.randint(0, height)
        x2 = random.randint(0, width)
        y2 = random.randint(0, height)

        color = (
            random.randint(50, 255),
            random.randint(50, 255),
            random.randint(50, 255)
        )

        draw.line(
            (x1, y1, x2, y2),
            fill=color,
            width=random.randint(1, 3)
        )

    # دایره‌ها و شکل‌های مزاحم
    for _ in range(35):
        x = random.randint(0, width)
        y = random.randint(0, height)
        r = random.randint(2, 9)

        color = (
            random.randint(60, 255),
            random.randint(60, 255),
            random.randint(60, 255)
        )

        draw.ellipse(
            (x-r, y-r, x+r, y+r),
            outline=color,
            width=random.randint(1, 3)
        )

    # فونت ویندوز
    font_paths = [
        "C:/Windows/Fonts/arialbd.ttf",
        "C:/Windows/Fonts/timesbd.ttf",
        "C:/Windows/Fonts/segoeuib.ttf"
    ]

    font_path = next(
        (p for p in font_paths if os.path.exists(p)),
        None
    )

    # رسم حروف و اعداد با زاویه تصادفی
    x_position = 12

    for char in code:

        if font_path:
            font = ImageFont.truetype(
                font_path,
                random.randint(38, 52)
            )
        else:
            font = ImageFont.load_default()

        layer = Image.new("RGBA", (75, 75), (0, 0, 0, 0))
        layer_draw = ImageDraw.Draw(layer)

        color = (
            random.randint(150, 255),
            random.randint(150, 255),
            random.randint(150, 255),
            255
        )

        layer_draw.text(
            (8, 5),
            char,
            font=font,
            fill=color,
            stroke_width=1,
            stroke_fill=(20, 20, 20)
        )

        angle = random.randint(-25, 25)
        layer = layer.rotate(
            angle,
            resample=Image.Resampling.BICUBIC,
            expand=False
        )

        image.paste(
            layer,
            (x_position, random.randint(8, 23)),
            layer
        )

        x_position += 43

    # نویز نهایی
    draw = ImageDraw.Draw(image)

    for _ in range(250):
        x = random.randint(0, width - 1)
        y = random.randint(0, height - 1)

        color = (
            random.randint(40, 255),
            random.randint(40, 255),
            random.randint(40, 255)
        )

        draw.point((x, y), fill=color)

    # کمی تاری
    image = image.filter(
        ImageFilter.GaussianBlur(0.35)
    )

    # ذخیره تصویر
    os.makedirs("captchas", exist_ok=True)

    file_path = f"captchas/captcha_{user_id}.png"
    image.save(file_path)

    # ذخیره جواب و زمان ساخت
    captcha_codes[str(user_id)] = {
        "code": code,
        "time": time.time()
    }

    return file_path


# بررسی جواب کاربر
def check_captcha(user_id, answer):

    user_id = str(user_id)

    data = captcha_codes.get(user_id)

    if not data:
        return False

    # اعتبار ۲ دقیقه
    if time.time() - data["time"] > 120:
        captcha_codes.pop(user_id, None)
        return False

    if answer.strip() == data["code"]:
        captcha_codes.pop(user_id, None)
        return True

    return False

async def send_captcha(bot, message):
    sender_id = str(getattr(message, "sender_id", "") or getattr(message, "author_guid", ""))
    chat_id = str(message.chat_id)
    # کلید جدا برای هر کاربر در هر گروه؛ نام فایل هم در ویندوز معتبر می‌ماند.
    captcha_user_key = f"{chat_id}_{sender_id}"
    path = create_captcha(captcha_user_key)
    await bot.send_photo(chat_id, path)
    await message.reply("🧩 کد ۶ کاراکتری داخل تصویر را وارد کن. تا ۲ دقیقه اعتبار دارد.")

def get_price(code):
    url = f"https://nerkhara.com/api/v1/latest/{code}.json"

    response = requests.get(url, timeout=30)
    response.raise_for_status()

    item = response.json()["item"]

    if item.get("stale") or item.get("price") is None:
        raise Exception("قیمت به‌روز نیست")

    return item["price"]


