def game_session(chat_id, user_id):
    return db.setdefault("game_sessions", {}).setdefault(f"{chat_id}:{user_id}", {})

def group_admin(chat_id, user_id):
    return str(user_id) == get_group_owner(chat_id) or str(user_id) in db.get("special_admins", {}).get(str(chat_id), [])


def is_group_admin_command(text):
    """فرمان‌هایی که فقط مالک یا مدیر ویژه می‌توانند اجرا کنند."""
    exact = {
        "قفل گروه", "باز گروه", "لیست فیلتر کلمه", "لیست سکوت",
        "عضویت اجباری فعال", "عضویت اجباری غیرفعال", "ریست عضویت اجباری",
        "پاکسازی لیست سکوت", "پاکسازی اخطار ها", "پاکسازی اخطارها",
        "لیست قفل", "قفل همه", "باز همه", "اخطار", "بن", "انبن",
        "سکوت", "رفع سکوت", "ویژه", "حذف ویژه", "لیست ویژه", "کیل", "رفع کیل"
    }
    prefixes = ("فیلتر کلمه ", "حذف فیلتر کلمه ", "قفل ", "باز ", "تنظیم اخطار ")
    return text in exact or text.startswith(prefixes + ("عضویت اجباری فعال ",))

def get_media_lock_type(message):
    attrs = {
        "sticker": "استیکر", "photo": "عکس", "image": "عکس",
        "video": "ویدیو", "voice": "ویس", "audio": "آهنگ",
        "document": "فایل", "file": "فایل", "gif": "گیف",
        "animation": "گیف", "poll": "نظرسنجی", "location": "لوکیشن",
        "contact": "مخاطب", "forward": "فوروارد", "is_forward": "فوروارد"
    }
    for attr, lock_name in attrs.items():
        if getattr(message, attr, None):
            return lock_name
    kind = str(getattr(message, "type", "") or getattr(message, "content_type", "")).lower()
    for token, lock_name in [
        ("sticker", "استیکر"), ("photo", "عکس"), ("image", "عکس"),
        ("video", "ویدیو"), ("voice", "ویس"), ("audio", "آهنگ"),
        ("document", "فایل"), ("file", "فایل"), ("gif", "گیف"),
        ("poll", "نظرسنجی"), ("location", "لوکیشن"), ("contact", "مخاطب"),
        ("forward", "فوروارد")
    ]:
        if token in kind:
            return lock_name
    return None

@bot.on_message()
async def nishi_locks_games(bot: Robot, message: Message):
    raw = getattr(message, "text", None)
    text = raw.strip() if isinstance(raw, str) else ""
    chat_id, sender_id = str(message.chat_id), str(message.sender_id)

    # مدیریت فهرست سکوت و پاکسازی اخطارها (فقط مالک یا مدیر ویژه)
    if text in ("لیست سکوت", "پاکسازی لیست سکوت", "پاکسازی اخطار ها", "پاکسازی اخطارها"):
        if not group_admin(chat_id, sender_id):
            return

        if text == "لیست سکوت":
            muted_ids = sorted(muted_users.get(chat_id, set()))
            if not muted_ids:
                await message.reply("🔇 لیست سکوت این گروه خالی است.")
            else:
                lines = [f"🔇 لیست کاربران سکوت‌شده ({len(muted_ids)} نفر):"]
                lines.extend(f"{i}. {uid}" for i, uid in enumerate(muted_ids, 1))
                await message.reply("\n".join(lines))
            return

        if text == "پاکسازی لیست سکوت":
            removed = len(muted_users.get(chat_id, set()))
            muted_users[chat_id] = set()
            db.setdefault("muted_users", {})[chat_id] = []
            save_db(db)
            await message.reply(f"✅ لیست سکوت پاکسازی شد.\nتعداد کاربران خارج‌شده از سکوت: {removed}")
            return

        warnings = db.setdefault("user_warnings", {})
        keys = [key for key in list(warnings) if key.startswith(chat_id + ":")]
        for key in keys:
            warnings.pop(key, None)
        save_db(db)
        await message.reply(f"✅ تمام اخطارهای این گروه پاک شد.\nتعداد سوابق پاک‌شده: {len(keys)}")
        return

    # قفل کلی گروه برای پیام‌های رسانه‌ای نیز اعمال شود.
    if not text and db.setdefault("group_locked", {}).get(chat_id, False) and not group_admin(chat_id, sender_id):
        try:
            await message.delete()
        except Exception:
            pass
        await give_warning(bot, message, sender_id, "ارسال پیام هنگام قفل بودن گروه")
        return

    # قفل رسانه حتی وقتی پیام همراه کپشن متنی است بررسی می‌شود.
    media_type = get_media_lock_type(message)
    if media_type and db.setdefault("chat_locks", {}).get(chat_id, {}).get(media_type):
        if not group_admin(chat_id, sender_id):
            try:
                await message.delete()
            except Exception:
                pass
            await give_warning(bot, message, sender_id, f"ارسال {media_type} قفل‌شده")
            return

    if text in ("لیست قفل", "⌯ لیست قفل"):
        locks = db.setdefault("chat_locks", {}).get(chat_id, {})
        lines = ["⌯ لیست قفل 〔 وضعیت 〕"]
        lines.extend(f"• {name} {'🔒' if locks.get(name) else '🔓'}" for name in LOCK_NAMES)
        await message.reply("\n".join(lines))
        return

    if text.startswith("قفل ") or text.startswith("باز ") or text.endswith(" باز"):
        if not group_admin(chat_id, sender_id):
            return
        if text in ("قفل همه", "باز همه"):
            state = text.startswith("قفل")
            locks = db.setdefault("chat_locks", {}).setdefault(chat_id, {})
            for name in LOCK_NAMES:
                locks[name] = state
            save_db(db)
            await message.reply("🔒 همه قفل‌ها فعال شدند." if state else "🔓 همه قفل‌ها باز شدند.")
            return
        if text.startswith("قفل "):
            name, state = text[4:].strip(), True
        elif text.startswith("باز "):
            name, state = text[4:].strip(), False
        else:
            name, state = text[:-4].strip(), False
        name = LOCK_ALIASES.get(name, name)
        if name not in LOCK_NAMES:
            return
        db.setdefault("chat_locks", {}).setdefault(chat_id, {})[name] = state
        save_db(db)
        await message.reply(f"{'🔒 قفل' if state else '🔓 باز'} {name} انجام شد.")
        return

    if text.startswith("تنظیم اخطار "):
        if not group_admin(chat_id, sender_id):
            return
        try:
            limit = int(text.replace("تنظیم اخطار ", "", 1).strip())
