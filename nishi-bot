async def give_warning(bot, message, target_id, reason):
    chat_id = str(message.chat_id)
    target_id = str(target_id)
    warnings = db.setdefault("user_warnings", {})
    warning_key = f"{chat_id}:{target_id}"
    count = int(warnings.get(warning_key, 0)) + 1
    warnings[warning_key] = count
    limit = int(db.setdefault("warning_limits", {}).get(chat_id, 5))
    limit = max(1, min(limit, 20))
    save_db(db)

    if count >= limit:
        try:
            await bot.ban_member_chat(chat_id, target_id)
            warnings.pop(warning_key, None)
            save_db(db)
            warning_text = (
                "🚫 کاربر بن شد!\n"
                "━━━━━━━━━━━━━━━\n"
                f"👤 شناسه: {target_id}\n"
                f"🔗 [مشاهده پروفایل]({target_id})\n"
                f"⚠️ دلیل: {reason}\n"
                f"رسیدن به {limit} اخطار"
            )
        except Exception as e:
            print("Ban error:", repr(e))
            warning_text = (
                f"⚠️ اخطار {count} از {limit} ثبت شد.\n"
                "❌ ربات نتوانست کاربر را بن کند.\n"
                f"دلیل: {reason}"
            )
    else:
        warning_text = (
            f"⚠️ اخطار {count} از {limit}\n"
            f"❌ دلیل: {reason}\n\n"
            f"[مشاهده پروفایل]({target_id})"
        )

    try:
        await bot.send_message(chat_id, warning_text)
    except Exception as e:
        print("Warning send error:", repr(e))


