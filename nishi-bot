    if text not in ["سکوت", "رفع سکوت"]:
        return

    reply_id = getattr(message, "reply_to_message_id", None)

    if not reply_id:
        await message.reply("❌ روی پیام کاربر ریپلای کن.")
        return

    try:
        replied_msg = await bot.get_message(chat_id, reply_id)

        if not replied_msg:
            await message.reply("❌ پیام پیدا نشد.")
            return

        if isinstance(replied_msg, dict):
            target_id = (
                replied_msg.get("sender_id")
                or replied_msg.get("from_id")
                or replied_msg.get("author_id")
            )
        else:
            target_id = (
                getattr(replied_msg, "sender_id", None)
                or getattr(replied_msg, "from_id", None)
                or getattr(replied_msg, "author_id", None)
            )

        if not target_id:
            await message.reply("❌ شناسه کاربر پیدا نشد.")
            return

        target_id = str(target_id)

        if target_id == sender_id:
            await message.reply("❌ نمی‌توانی خودت را سکوت کنی!")
            return

        if target_id == get_group_owner(chat_id):
            await message.reply("❌ نمی‌توانی مالک ربات را سکوت کنی!")
            return

        if chat_id not in muted_users:
            muted_users[chat_id] = set()

        if text == "سکوت":

            muted_users[chat_id].add(target_id)
            db.setdefault("muted_users", {})[chat_id] = sorted(muted_users[chat_id])
            save_db(db)

            await message.reply(
                "🔇 کاربر سکوت شد!\n"
