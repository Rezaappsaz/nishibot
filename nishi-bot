        save_db(db)
        await message.reply(f"⚡ مسابقه سرعت! اولین نفر که دقیقاً بنویسه «{target}» برنده‌ست!")
        return

    if session.get("game") == "speed" and text == session.get("speed_target"):
        session.pop("game", None)
        session.pop("speed_target", None)
        save_db(db)
        await message.reply("🏁 آفرین! سریع‌تر از بقیه رسیدی (در حد این پیام 😄)")
